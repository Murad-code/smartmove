# ---------------------------------------------------------------------------
# Smart Move — production environment for the VPS
#
# Copy to .env.production on the server, fill in, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# chmod 600 this file. Never commit it.
# ---------------------------------------------------------------------------

# --- Image ------------------------------------------------------------------

# Published by .github/workflows/release.yml. Pin to a version tag rather than
# `latest` when you want a predictable rollback target.
APP_IMAGE=ghcr.io/murad-code/smartmove:latest

# Port on 127.0.0.1 that the host's nginx proxies to. Nothing public.
APP_PORT=3001

# --- Site -------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=https://smartmove4u.muradsprojects.co.uk
# Copied into the container as SITE_URL by docker-compose.prod.yml so email
# links follow this value at runtime rather than whatever was inlined at build.
SITE_URL=https://smartmove4u.muradsprojects.co.uk

# true on a preview or staging deployment: blocks all crawlers and sends
# `noindex` on every page. Set to false only for the real live site.
SITE_NOINDEX=true

# --- Database ---------------------------------------------------------------
# Postgres is never published outside the Docker network, but use a real
# password anyway: generate with `openssl rand -hex 24`.

POSTGRES_USER=smartmove
POSTGRES_PASSWORD=
POSTGRES_DB=smartmove

# --- Secrets ----------------------------------------------------------------

# Signs admin sessions. Generate with `openssl rand -hex 32`.
# Changing this signs every logged-in user out.
PAYLOAD_SECRET=

# --- Email ------------------------------------------------------------------

EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Resend only accepts a `from` on a domain you have verified with it, or its
# sandbox sender. The sandbox can only deliver to the Resend account owner.
EMAIL_FROM=Smart Move Website <onboarding@resend.dev>
EMAIL_TO=

# --- First run --------------------------------------------------------------

# Creates the admin account and the starter pages on first boot.
#   true  - set the site up if it is empty, do nothing once it has content.
#           Safe to leave on permanently.
#   force - re-apply the seed on every restart. Handy while iterating on a
#           demo, but it overwrites anything the client has edited.
#   unset - never seed.
RUN_SEED_ON_BOOT=true

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Turns this deployment into the demonstration site: the six demo listings and
# the home page photography that goes with them. On its own it also seeds on
# every boot, so the demo comes back to a known state after a restart; set
# RUN_SEED_ON_BOOT explicitly if you would rather it did not.
#
# Nothing this writes is Smart Move's, so leave SITE_NOINDEX=true on beside it
# and clear it before the site becomes a real one.
SEED_DEMO=false

# --- Optional ---------------------------------------------------------------

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_PLAUSIBLE_HOST=
