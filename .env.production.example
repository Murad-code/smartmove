# ---------------------------------------------------------------------------
# Smart Move — production environment for the VPS
#
# Copy to .env.production on the server, fill in, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# chmod 600 this file. Never commit it.
# ---------------------------------------------------------------------------

# --- Image ------------------------------------------------------------------

# Published by ./deploy/release.sh to Docker Hub. Pin to a version tag rather
# than `latest` when you want a predictable rollback target.
APP_IMAGE=muradkamali/smartmove:1.3.0

# Port on 127.0.0.1 that the host's nginx proxies to. Nothing public.
APP_PORT=3001

# --- Site -------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=https://smartmove4u.muradsprojects.co.uk
# Copied into the container as SITE_URL by docker-compose.prod.yml so email
# links follow this value at runtime rather than whatever was inlined at build.
SITE_URL=https://smartmove4u.muradsprojects.co.uk

# true on a preview or staging deployment: blocks all crawlers and sends
# `noindex` on every page. Set to false only for the real live site.
SITE_NOINDEX=true

# --- Database ---------------------------------------------------------------
# Postgres is never published outside the Docker network, but use a real
# password anyway: generate with `openssl rand -hex 24`.

POSTGRES_USER=smartmove
POSTGRES_PASSWORD=
POSTGRES_DB=smartmove

# --- Secrets ----------------------------------------------------------------

# Signs admin sessions. Generate with `openssl rand -hex 32`.
# Changing this signs every logged-in user out.
PAYLOAD_SECRET=

# --- Email ------------------------------------------------------------------

EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Resend only accepts a `from` on a domain you have verified with it, or its
# sandbox sender. The sandbox can only deliver to the Resend account owner.
EMAIL_FROM=Smart Move Website <onboarding@resend.dev>
EMAIL_TO=

# --- Owner account ----------------------------------------------------------

# Created on first boot if that address is not already a user. Hidden from
# other admins on the Users list and cannot be deleted. Keep the email set
# so the panel knows which row to hide. SEED_ADMIN_* names still work.
ROOT_ADMIN_EMAIL=
ROOT_ADMIN_PASSWORD=

# Optional. Adds the six demo listings and the home page photography that
# goes with them. Off means an empty site besides the starter pages.
# Pair with SITE_NOINDEX=true; nothing this writes is Smart Move's.
SEED_DEMO=false

# --- Optional ---------------------------------------------------------------

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_PLAUSIBLE_HOST=
