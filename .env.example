# ---------------------------------------------------------------------------
# Smart Move — environment variables
# Copy to .env and fill in. Never commit .env.
# See docs/environment-variables.md for the full reference.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string.
#   Local Postgres from docker-compose.yml:
#     postgres://postgres:postgres@127.0.0.1:5432/smartmove
#   A Postgres you installed yourself may not need the password:
#     postgres://postgres@127.0.0.1:5432/smartmove
#   Inside the production stack, Compose builds this from POSTGRES_* below and
#   this value is ignored.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/smartmove

# Signs Payload auth tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Public origin of the site, no trailing slash. Used for canonicals,
# sitemap.xml, Open Graph URLs and absolute links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email notifications ----------------------------------------------------

# console | resend
# "console" logs enquiry notifications instead of sending them. Use in dev.
EMAIL_PROVIDER=console

# Required when EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Verified sender, e.g. "Smart Move Website <website@smartmove4u.co.uk>"
EMAIL_FROM=
# Where enquiry notifications are delivered. Comma-separate for several.
EMAIL_TO=

# --- Optional ---------------------------------------------------------------

# Cloudflare Turnstile. Both must be set to enable it; otherwise the forms
# fall back to honeypot plus timing checks only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics. Leave blank to ship no analytics at all.
# plausible | ga4
NEXT_PUBLIC_ANALYTICS_PROVIDER=
# Plausible: the site domain. GA4: the G-XXXXXXX measurement ID.
NEXT_PUBLIC_ANALYTICS_ID=
# Self-hosted Plausible only.
NEXT_PUBLIC_PLAUSIBLE_HOST=

# Seed script. SEED_ADMIN_PASSWORD is required to create the first account.
SEED_ADMIN_EMAIL=admin@smartmove4u.co.uk
SEED_ADMIN_PASSWORD=
# Adds eight obviously fake demo properties. Development only.
SEED_DEMO_PROPERTIES=false
